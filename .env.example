# Copy this file to .env and fill in your own keys. Never commit .env.

# Which LLM answers the questions: groq (default) | claude | huggingface
LLM_PROVIDER=groq

# Groq (primary, free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# llama-3.3-70b-versatile - model_not_found Error.

# Anthropic Claude (backup / quality comparison, paid) - https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Hugging Face (original setup, optional) - https://huggingface.co/settings/tokens
HF_TOKEN=
